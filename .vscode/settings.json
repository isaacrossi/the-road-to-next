{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  /* --- Global Editor Completions & Intentionally Silenced Prompts --- */
  "editor.inlineSuggest.enabled": false,
  "editor.inlineSuggest.showToolbar": "never",
  "editor.suggest.preview": false,
  "editor.suggest.showInlineDetails": false,
  "editor.suggestOnTriggerCharacters": false,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.tabCompletion": "off",
  "editor.parameterHints.enabled": false,
  "editor.snippetSuggestions": "none",
  "editor.wordBasedSuggestions": "off",
  "editor.quickSuggestions": {
    "other": "off",
    "comments": "off",
    "strings": "off"
  },

  /* --- Antigravity & AI Provider Configurations --- */
  "antigravity.inlineSuggest.enabled": false,
  "antigravity.autocomplete.enabled": false,
  "antigravity.enableAutocomplete": false,
  "antigravity.codeLens.enabled": false,
  "antigravity.ghostText.enabled": false,
  "antigravity.ai.enabled": false,
  "github.copilot.enable": {
    "*": false
  },
  "cursor.cpp.enabled": false,
  "cloudcode.duetAI.enableAutocomplete": false,

  /* --- Language-Specific Overrides --- */
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.inlineSuggest.enabled": false,
    "editor.suggestOnTriggerCharacters": false,
    "editor.quickSuggestions": {
      "other": "off",
      "comments": "off",
      "strings": "off"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.inlineSuggest.enabled": false,
    "editor.suggestOnTriggerCharacters": false,
    "editor.quickSuggestions": {
      "other": "off",
      "comments": "off",
      "strings": "off"
    }
  },
  "[javascriptreact]": {
    "editor.inlineSuggest.enabled": false,
    "editor.suggestOnTriggerCharacters": false,
    "editor.quickSuggestions": {
      "other": "off",
      "comments": "off",
      "strings": "off"
    }
  },
  "[typescriptreact]": {
    "editor.inlineSuggest.enabled": false,
    "editor.suggestOnTriggerCharacters": false,
    "editor.quickSuggestions": {
      "other": "off",
      "comments": "off",
      "strings": "off"
    }
  },
  "[python]": {
    "editor.inlineSuggest.enabled": false,
    "editor.suggestOnTriggerCharacters": false,
    "editor.quickSuggestions": {
      "other": "off",
      "comments": "off",
      "strings": "off"
    }
  }
}
